# OpenCruise の x86 UEFI ディスク: EFI(systemd-boot) + ルート + /home(アプリの設定・ログ・背景画像などの書き込み領域)
# 車載は電源が急に切れるので、ルートを読み取り専用にして、書き込みを /home だけに絞れるようにしている。
# ${OPENCRUISE_CMDLINE} は conf/distro/opencruise.conf と local.conf で決める(読み取り専用のときは "ro" が付く)。
part /boot --source bootimg-efi --sourceparams="loader=systemd-boot" --ondisk sda --label boot --active --align 1024 --use-uuid
part / --source rootfs --ondisk sda --fstype=ext4 --label root --align 1024 --use-uuid
part /home --ondisk sda --fstype=ext4 --label data --size 1024 --align 1024 --use-uuid

bootloader --ptable gpt --timeout=0 --append="rootwait ${OPENCRUISE_CMDLINE}"
