 (instances (project "pulsein" (path "/39bc15ed-4c26-4e20-aa02-54f1e817f047" (reference "#FLG003") (unit 1)))))
(text "Input: 0-16 V push-pull, or open collector with JP1 pull-up. R2 22k + C1 1nF (tau 22 us, up to ~10 kHz), DZ1 clamps U1 input < 5 V.\nU1 Schmitt @3.3 V: VT+ 1.8 V / VT- 1.0 V. JP2 closed (12 V signals only): threshold ~5.8 V / 3.2 V for noisy 12 V lines.\nDo NOT close JP2 with 5 V or 3.3 V signals. LED D1 blinks with the pulses. +5V / +12V on J2 power a sensor (PTC on main board).\nJ1 pin order = PWR-CTRL J8/J9 (1 VSW_EXT, 2 5V_EXT, 3 GND, 4 IO): use a straight XH4 cable." (exclude_from_sim no) (at 15.24 154.94 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "c5efa6cc-40d3-41bb-9908-2a30c1f0bfb3"))
 (sheet_instances (path "/" (page "1")))
