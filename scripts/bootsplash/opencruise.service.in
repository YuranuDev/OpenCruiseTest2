# OpenCruise を tty1 で自動起動する(install.sh が @...@ を置き換えて /etc/systemd/system/ に入れる)。
# ログインのセッション(PAMName=login)として動かすので、音(PipeWire など)や画面・入力の権限はログインしたときと同じ。
#
# Linux の起動画面(Plymouth)からの引き継ぎ(Plymouth の操作は root でしかできないので、ここで行う。"+" は root で実行):
#  1. 起動前: plymouth deactivate … Plymouth は画面(DRM)を手放すが、最後の画面は出したまま
#  2. アプリが画面を開いて最初の 1 枚を描き、準備完了(READY=1)を知らせる(Type=notify)
#  3. 起動後: plymouth quit --retain-splash … 画面はもうアプリのものなので、黒くならない
# アプリが止まったとき・起動できなかったときは、Plymouth を終わらせてコンソールに戻す。
#
# コンソール: アプリを終了すると(メニューの終了、Ctrl+Alt+Backspace、systemctl stop)、tty1 にログイン画面を出す。
# 落ちて再起動を繰り返したとき(起動の上限に達したとき)も同じ。アプリに戻るときは: sudo systemctl start opencruise
[Unit]
Description=OpenCruise
# ユーザーのサービス(PipeWire などの音)が先に立ち上がっているように、ユーザーの systemd を先に起動する
Wants=user@@UID@.service
After=systemd-user-sessions.service plymouth-start.service sound.target getty@tty1.service user@@UID@.service
Conflicts=getty@tty1.service
# 落ち続けて止まったときは、tty1 にログイン画面を出す
OnFailure=getty@tty1.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
TimeoutStartSec=60
User=@USER@
PAMName=login
TTYPath=/dev/tty1
TTYReset=no
TTYVHangup=yes
TTYVTDisallocate=no
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
WorkingDirectory=@WORKDIR@
Environment=QT_QPA_PLATFORM=eglfs
Environment=OPENCRUISE_SPLASH_HANDOFF=1
@TOUCH_ENV@
# アプリが起動して保存済みの明るさを書き込むまでは最大の明るさにする("$$" は systemd での "$")
ExecStartPre=-+/bin/sh -c 'for d in /sys/class/backlight/*; do [ -r "$$d/max_brightness" ] && read m < "$$d/max_brightness" && echo "$$m" > "$$d/brightness"; done'
ExecStartPre=-+/usr/bin/plymouth deactivate
ExecStart=@APP@
ExecStartPost=-+/usr/bin/plymouth quit --retain-splash
ExecStopPost=-+/usr/bin/plymouth quit
# 正常に終わったとき(終了の操作・systemctl stop)は、tty1 にログイン画面を出す(落ちたときは再起動するので出さない)
ExecStopPost=-+/bin/sh -c '[ "$SERVICE_RESULT" = success ] && systemctl --no-block start getty@tty1.service || true'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
